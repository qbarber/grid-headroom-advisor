{
  "name": "grid-headroom-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "Advisor for evaluating spare capacity (headroom) on electricity grid substations.",
  "main": "src/server.js",
  "scripts": {
    "generate:sample": "node scripts/generateSample.js",
    "simulate:sample": "node scripts/simulateSample.js",
    "decide:sample": "node scripts/decideSample.js",
    "eval": "node scripts/runEval.js",
    "server": "node src/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "grid",
    "substation",
    "capacity",
    "simulation"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
